{
  "name": "vscode-assistive-tools",
  "displayName": "Assistive Tools",
  "description": "VSCode 辅助开发工具：安全生成枚举 Map/Options，快速创建 Vue、UniApp、Taro 组件和页面。",
  "version": "0.0.6",
  "publisher": "ihopefulChina",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihopefulChina/vscode-assistiveTools.git"
  },
  "homepage": "https://github.com/ihopefulChina/vscode-assistiveTools#readme",
  "bugs": {
    "url": "https://github.com/ihopefulChina/vscode-assistiveTools/issues"
  },
  "license": "MIT",
  "icon": "./static/logo.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "keywords": [
    "enum",
    "typescript",
    "javascript",
    "code-generation",
    "assistive"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onCommand:assistiveTools.convertEnum",
    "onCommand:assistiveTools.createComponent",
    "onCommand:assistiveTools.createPage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "assistiveTools.convertEnum",
        "title": "转换枚举"
      },
      {
        "command": "assistiveTools.createComponent",
        "title": "创建组件",
        "icon": "$(file-code)"
      },
      {
        "command": "assistiveTools.createPage",
        "title": "创建页面",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "assistiveTools.createComponent",
          "group": "navigation"
        },
        {
          "command": "assistiveTools.createPage",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0"
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "typescript": "^4.9.5"
  }
}
